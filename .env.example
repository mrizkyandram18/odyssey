# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Gatekeeper / Firebase (read-only Firestore) ---
FIREBASE_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
PARENT_ID=

# --- Gatekeeper Min Build ---
GATEKEEPER_MIN_BUILD_NUMBER=49

# --- Odyssey Sessions ---
SESSION_SIGNING_SECRET=
ADMIN_SECRET=

# --- Security & Rate Limiting ---
ODYSSEY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ODYSSEY_MAX_BODY_BYTES=1048576
ODYSSEY_RATE_LIMIT_WINDOW_SEC=60
ODYSSEY_RATE_LIMIT_MAX_HITS=100
ODYSSEY_LOGIN_RATE_LIMIT_MAX=5
ODYSSEY_ADMIN_RATE_LIMIT_MAX=30

# --- Observability ---
# Token required for /metrics and /debug/profile endpoints.
# Set in production; leave empty only for local development.
ODYSSEY_INTERNAL_METRICS_TOKEN=

# --- Daily Turn Configuration ---
# IANA timezone for daily turn calendar date computation (default: Asia/Jakarta)
ODYSSEY_TIMEZONE=Asia/Jakarta
# XP awarded per daily turn (default: 30)
ODYSSEY_DAILY_TURN_XP=30
# Max daily turns per user per calendar day (default: 1)
ODYSSEY_MAX_DAILY_TURNS=1

# --- Realm Progression Configuration ---
# Progress units added to a realm per completed quest (default: 25)
ODYSSEY_REALM_PROGRESS_PER_QUEST=25
# Progress value at which a realm is marked COMPLETE (default: 100)
ODYSSEY_REALM_COMPLETION_THRESHOLD=100
