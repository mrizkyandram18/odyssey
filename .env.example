# --- Supabase (Required for Prototype) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Odyssey Sessions (Required) ---
SESSION_SIGNING_SECRET=development-secret-key-replace-in-prod
ADMIN_SECRET=development-admin-key-replace-in-prod

# --- Security & Rate Limiting ---
ODYSSEY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ODYSSEY_MAX_BODY_BYTES=1048576
ODYSSEY_RATE_LIMIT_WINDOW_SEC=60
ODYSSEY_RATE_LIMIT_MAX_HITS=100
ODYSSEY_LOGIN_RATE_LIMIT_MAX=5
ODYSSEY_ADMIN_RATE_LIMIT_MAX=30

# --- Observability ---
ODYSSEY_INTERNAL_METRICS_TOKEN=dev-token

# --- Telegram Admin Notification (payout/claim PENDING) ---
# Reuses kuota-copy bot pattern: same TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# names, same SendTelegramMessage helper shape. Values stay in local env
# (.env.local) or secret manager — never commit real values here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone ---
ODYSSEY_TIMEZONE=Asia/Jakarta

# --- Web Push (VAPID) ---
# Required for push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
