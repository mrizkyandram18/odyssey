{
    "installCommand": "cd web && npm ci",
    "buildCommand": "cd web && npm run build",
    "outputDirectory": "web/dist",
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api" },
        { "source": "/metrics", "destination": "/api" },
        { "source": "/version", "destination": "/api" },
        { "source": "/health", "destination": "/api" },
        { "source": "/ready", "destination": "/api" },
        { "source": "/live", "destination": "/api" },
        { "source": "/debug/(.*)", "destination": "/api" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Pragma",
                    "value": "no-cache"
                },
                {
                    "key": "Expires",
                    "value": "0"
                }
            ]
        }
    ]
}