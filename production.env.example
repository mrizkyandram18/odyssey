# --- Docker / Deployment ---
PORT=8080

# --- Supabase (PostgreSQL via PostgREST REST) ---
# Use the internal docker network name if running Supabase in a sidecar,
# or the public Supabase URL for managed Supabase.
SUPABASE_URL=http://postgres:5432
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Gatekeeper / Firebase (read-only Firestore for auth) ---
FIREBASE_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
PARENT_ID=your-gatekeeper-parent-id

# --- Odyssey Sessions ---
SESSION_SIGNING_SECRET=replace-with-strong-hmac-secret-min-32-chars
ADMIN_SECRET=replace-with-strong-admin-secret-min-32-chars

# --- Gatekeeper Min Build ---
GATEKEEPER_MIN_BUILD_NUMBER=49

# --- Timezone ---
ODYSSEY_TIMEZONE=Asia/Jakarta

# --- Web Push (VAPID) ---
# Provide real values via secret manager — never commit them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Security / Rate Limiting ---
ODYSSEY_ALLOWED_ORIGINS=https://your-domain.com
ODYSSEY_MAX_BODY_BYTES=1048576
ODYSSEY_RATE_LIMIT_WINDOW_SEC=60
ODYSSEY_RATE_LIMIT_MAX_HITS=100
ODYSSEY_LOGIN_RATE_LIMIT_MAX=5
ODYSSEY_ADMIN_RATE_LIMIT_MAX=30

# --- Telegram Admin Notification (payout/claim PENDING) ---
# Same bot/pattern as kuota-copy (TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID).
# Provide real values via production.env or secret manager — never commit them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PostgreSQL (for docker-compose sidecar) ---
POSTGRES_USER=odyssey
POSTGRES_PASSWORD=odyssey_dev
POSTGRES_DB=odyssey
POSTGRES_PORT=5432

# --- Nginx ---
NGINX_PORT=80
NGINX_PORT_SSL=443
